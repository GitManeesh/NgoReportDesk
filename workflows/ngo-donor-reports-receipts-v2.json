    {
      "parameters": {
        "jsCode": "const input=$('Validate Request and Approval').first().json;\nconst raw=$json.text??$json.output;\nlet parsed;try{parsed=typeof raw==='string'?JSON.parse(raw.trim().replace(/^```(?:json)?\\s*/i,'').replace(/\\s*```$/,'')):raw;}catch{throw Error('Invalid model JSON');}\nif(!parsed||typeof parsed!=='object'||Array.isArray(parsed))throw Error('Invalid AI response');\nconst numbers=s=>s.match(/\\d+(?:[.,]\\d+)*/g)||[];const report={};const repaired=[];\nfor(const[key,source,max]of [['activities',input.notes,12],['challenges',input.challenges,8],['next_steps',input.next,8]]){\n if(!Array.isArray(parsed[key])||parsed[key].length>max)throw Error('Invalid section '+key);\n report[key]=parsed[key].map((x,i)=>{\n if(!x||typeof x.summary!=='string'||typeof x.source_quote!=='string'||!x.summary.trim()||!x.source_quote.trim()||x.source_quote.length>1500||!source.includes(x.source_quote))throw Error('Unverified evidence in '+key);\n let summary=x.summary.trim();if(numbers(summary).some(n=>!numbers(x.source_quote).includes(n))||summary.length>600){if(x.source_quote.length>600)throw Error('Shorter supporting quote required');summary=x.source_quote;repaired.push('Used source wording for '+key+' item '+(i+1));}\n if(/\\b(incredible|amazing|outstanding|remarkable|transformative)\\b/i.test(summary))throw Error('Use factual wording without praise');\n return{summary,source_quote:x.source_quote};});\n}\nif(!report.activities.length)throw Error('No supported activities');\nif(!Array.isArray(parsed.warnings)||parsed.warnings.some(w=>typeof w!=='string'||w.length>400))throw Error('Invalid review warnings');\nreport.warnings=[...[...new Set([...repaired,...parsed.warnings])].slice(0,7),'Review each claim and figure before approval. Do not infer unique beneficiaries from activity attendance.'];\nreturn[{json:{request_id:input.request_id,report,requires_review:true,approved:false,sent:false}}];"
      },
