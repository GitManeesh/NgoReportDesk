    {
      "parameters": {
        "jsCode": "const b=$json.body||{};\nconst action=b.action||'draft';\nif(!['draft','gmail','whatsapp','facebook','instagram','receipt_preview','gmail_pdf','whatsapp_pdf','capabilities'].includes(action))throw Error('Unsupported action');\nconst s=(k,max=16000)=>{const v=b[k]??'';if(typeof v!=='string'||v.length>max)throw Error('Invalid '+k);return v.trim();};\nconst out={beneficiaries:s('beneficiaries',3000),photos:s('photos',2000),donor_prompt:s('donor_prompt',30000),action,request_id:s('request_id',150),org:s('org',200),period:s('period',150),notes:s('notes'),challenges:s('challenges',5000),next:s('next',5000),approved_text:s('approved_text',50000),subject:s('subject',200)||'NGO report',email_to:s('email_to',254),whatsapp_to:s('whatsapp_to',30),public_text:s('public_text',2000),image_url:s('image_url',2000),whatsapp_phone_id:s('whatsapp_phone_id',80)||'1331179886742725',facebook_page_id:s('facebook_page_id',80)||'1444920948685962',instagram_id:s('instagram_id',80)||'17841469330811173'};\nif(!out.request_id)throw Error('Unique request_id required. Do not retry an uncertain delivery.');\nif(action==='draft'&&(!out.org||!out.period||out.notes.length<30))throw Error('org, period and at least 30 characters of notes required');\nif(['gmail','whatsapp','gmail_pdf','whatsapp_pdf'].includes(action)&&(b.approved!==true||!out.approved_text))throw Error('Human approval and approved_text required');\nif(['gmail','gmail_pdf'].includes(action)&&!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(out.email_to))throw Error('Valid email_to required');\nif(['whatsapp','whatsapp_pdf'].includes(action)&&(!/^\\+?[1-9]\\d{7,14}$/.test(out.whatsapp_to)||out.approved_text.length>4000))throw Error('Valid international whatsapp_to and text <=4000 characters required');\nif(['facebook','instagram'].includes(action)&&(b.public_approved!==true||!out.public_text))throw Error('Separately approved public_text required; do not send private reports to social');\nif((action==='instagram'||(action==='facebook'&&out.image_url))&&!/^https:\\/\\/[^\\s]+$/i.test(out.image_url))throw Error('Public HTTPS JPEG image_url required');\nif(action==='receipt_preview'){\n const amount=Number(b.amount);if(!Number.isFinite(amount)||amount<=0)throw Error('Positive amount required');\n out.receipt={reference:s('reference',100),date:s('date',50),donor:s('donor',200),currency:s('currency',10),amount};\n if(!out.org||Object.values(out.receipt).some(v=>v===''))throw Error('org, reference, date, donor, currency, amount required');\n}\nif(['gmail_pdf','whatsapp_pdf'].includes(action)){out.pdf_base64=s('pdf_base64',1800000);out.filename=s('filename',150);if(!/^[A-Za-z0-9+/]+=*$/.test(out.pdf_base64)||!out.pdf_base64.startsWith('JVBERi0')||!/^[-A-Za-z0-9_.]+\\.pdf$/.test(out.filename))throw Error('Valid PDF and safe filename required');if(out.approved_text.length>1000)throw Error('Thank-you must be under 1000 characters');}\nreturn [{json:out}];"
      },
